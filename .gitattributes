# 统一行尾：仓库内一律 LF（批处理除外），杜绝 CRLF 噪音与跨平台 diff 污染
* text=auto eol=lf

# Windows 批处理必须 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不参与转换
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.gif -text
*.ico -text
*.ttf -text
*.otf -text
*.woff -text
*.woff2 -text
*.jar -text
*.aar -text
*.apk -text
*.zip -text
*.7z -text
*.rar -text
*.so -text
*.db -text
*.mp3 -text
*.m4a -text
*.mp4 -text
