<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/highlight_shadow"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <!-- 半径 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/highlight_shadow_radius"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <SeekBar
        android:id="@+id/seekbar_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20"
        android:paddingBottom="12dp" />

    <!-- 横向偏移 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/highlight_shadow_offset_x"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <SeekBar
        android:id="@+id/seekbar_dx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20"
        android:paddingBottom="12dp" />

    <!-- 纵向偏移 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/highlight_shadow_offset_y"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <SeekBar
        android:id="@+id/seekbar_dy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="20"
        android:paddingBottom="12dp" />

    <!-- 颜色 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/highlight_shadow_color"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <View
        android:id="@+id/v_shadow_color"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/black" />

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
