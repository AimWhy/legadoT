<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">
    <!-- N: 数据诚实重排——书源常缺"字数/连载状态"等字段(有源站也不返回),故不做固定名片;
         顶部依次放本地可靠数据"阅读进度"(未读整行隐藏)、管理项、分隔线和简介。id 全部沿用。 -->

    <!-- 阅读进度(主角,本地数据可靠):已读百分比 + 当前章节;readProgress()==null(未读)时整行 gone,
         由 BookInfoActivity.showBook/bindInfoHeader 填 tv_read_status 文本与 ll_read_status 可见性。 -->
    <LinearLayout
        android:id="@+id/ll_read_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_m"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/read_dur_progress"
            android:src="@drawable/ic_bookmark"
            app:skin_tint="secondary"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tv_read_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            app:skin_textColor="onSurface"
            android:textColor="@color/primaryText"
            tools:text="已读 45%  ·  第138章 决战紫禁之巅" />

    </LinearLayout>

    <!-- N5 C5a: 管理三行块(书源/最新/分组)抽为共享 include,与 land activity_book_info.xml
         同源(见 view_book_info_manage_rows.xml 头注)。需要自带 id 才能让 include 的子 view id
         在 ItemBookInfoHeaderBinding 里展开为可访问字段(空 id 的 include 不展开)。 -->
    <include
        android:id="@+id/manage_rows"
        layout="@layout/view_book_info_manage_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 简介。书源常不返回简介，简介为空时整段 gone(upIntro)。与管理块之间用间距分隔——
         本布局与目录头/章节行同处一张连续内容面板(RecyclerView 背景),面板内部不画满宽实线。
         内联展开:按钮悬浮于折叠文本第 4 行行尾(bottom|end,折叠高度恰为 4 行),
         渐隐底(透明→面板底色)在代码侧铺设让行尾文字淡出;展开态 tv_intro 垫
         底部内边距,按钮落于文末右下不遮字。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s">

        <io.legado.app.ui.widget.text.ScrollTextView
            android:id="@+id/tv_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="4"
            android:paddingHorizontal="@dimen/space_xs"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_body"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/secondaryText"
            tools:text="@string/book_intro"
            tools:ignore="RtlHardcoded,RtlSymmetry" />

        <io.legado.app.ui.widget.text.AccentTextView
            android:id="@+id/tv_intro_expand"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/book_intro_expand_height"
            android:layout_gravity="bottom|end"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|end"
            android:paddingStart="40dp"
            android:paddingEnd="@dimen/space_xs"
            android:text="@string/book_intro_expand"
            android:textSize="@dimen/text_caption_l"
            android:visibility="gone"
            tools:ignore="RtlSymmetry"
            tools:visibility="visible" />

    </FrameLayout>

    <!-- N: 原 ll_toc(Chapters:… / View Chapters)已移除——与下方内嵌目录头(item_book_info_toc_header)
         的"Chapters: N / 排序"信息重复。打开完整目录页(搜索/分卷)的入口改由目录头承担(点整行)。 -->

</LinearLayout>
