<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_info_card_top"
    app:skin_background="background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">
    <!-- N3a 抽取:原 activity_book_info.xml 的 ll_info 整棵子树原样搬入独立 header,
         所有子 id 照搬未改;root 背板改运行时 MaterialShapeDrawable 圆角(见 BookInfoActivity.bindInfoHeader),
         XML 侧 bg_info_card_top 仅兜底(圆角形状与运行时一致,避免绘制间隙) -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <ImageView
                android:id="@+id/iv_web"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/origin_format"
                android:paddingRight="2dp"
                android:src="@drawable/ic_web_outline"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_origin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/origin_format" />

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/tv_change_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/change_origin"
                android:textSize="@dimen/text_caption_l"
                app:radius="@dimen/radius_full" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ic_book_last"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/read_dur_progress"
                android:paddingRight="2dp"
                android:src="@drawable/ic_book_last"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_lasted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/read_dur_progress" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <ImageView
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/read_dur_progress"
                android:paddingRight="2dp"
                android:src="@drawable/ic_groups"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/group_s" />

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/tv_change_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/change_group"
                android:textSize="@dimen/text_caption_l"
                app:radius="@dimen/radius_full" />

        </LinearLayout>

    </LinearLayout>

    <io.legado.app.ui.widget.text.ScrollTextView
        android:id="@+id/tv_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:paddingLeft="8dp"
        android:paddingBottom="8dp"
        android:text="@string/book_intro"
        app:skin_textColor="onSurfaceVariant"
        android:textColor="@color/secondaryText"
        android:textIsSelectable="true"
        android:textSize="14sp"
        android:visibility="visible"
        tools:ignore="RtlHardcoded,RtlSymmetry" />

    <LinearLayout
        android:id="@+id/ll_toc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <ImageView
            android:layout_width="18sp"
            android:layout_height="18sp"
            android:contentDescription="@string/read_dur_progress"
            android:paddingRight="2dp"
            android:src="@drawable/ic_folder_open"
            app:skin_tint="onSurfaceVariant"
            app:tint="@color/tv_text_summary"
            tools:ignore="RtlHardcoded,RtlSymmetry" />

        <TextView
            android:id="@+id/tv_toc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingRight="6dp"
            android:singleLine="true"
            app:skin_textColor="onSurface"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_subtitle"
            tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
            tools:text="@string/toc_s" />

        <io.legado.app.ui.widget.text.AccentBgTextView
            android:id="@+id/tv_toc_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/view_toc"
            android:textSize="@dimen/text_caption_l"
            app:radius="@dimen/radius_full" />

    </LinearLayout>

</LinearLayout>
