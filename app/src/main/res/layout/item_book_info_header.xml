<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_info_card_top"
    app:skin_background="background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_s">
    <!-- N: 数据诚实重排——书源常缺"字数/连载状态"等字段(有源站也不返回),故不做固定名片;
         顶部只放本地可靠数据"阅读进度"(未读整行隐藏),下接简介、管理项、目录入口。id 全部沿用。 -->

    <!-- 阅读进度(主角,本地数据可靠):已读百分比 + 当前章节;readProgress()==null(未读)时整行 gone,
         由 BookInfoActivity.showBook/bindInfoHeader 填 tv_read_status 文本与 ll_read_status 可见性。 -->
    <LinearLayout
        android:id="@+id/ll_read_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_m"
        android:visibility="gone"
        tools:ignore="UseCompoundDrawables"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/read_dur_progress"
            android:src="@drawable/ic_bookmark"
            app:skin_tint="secondary"
            app:tint="@color/accent" />

        <TextView
            android:id="@+id/tv_read_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            app:skin_textColor="onSurface"
            android:textColor="@color/primaryText"
            tools:text="已读 45%  ·  第138章 决战紫禁之巅" />

    </LinearLayout>

    <!-- 简介(前置:读者最想看的,紧跟名片)。书源常不返回简介 → 内容为空时整段 gone(连同下方分隔线),
         由 BookInfoActivity.showBook/bindInfoHeader 按 getDisplayIntro() 是否为空控制可见性,不留占位空白。 -->
    <io.legado.app.ui.widget.text.ScrollTextView
        android:id="@+id/tv_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/space_xs"
        android:paddingBottom="@dimen/space_s"
        android:textIsSelectable="true"
        android:textSize="@dimen/text_body"
        app:skin_textColor="onSurfaceVariant"
        android:textColor="@color/secondaryText"
        tools:text="@string/book_intro"
        tools:ignore="RtlHardcoded,RtlSymmetry" />

    <View
        android:id="@+id/v_intro_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@color/divider" />

    <!-- 管理区:书源/最新/分组(下沉、弱化) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <ImageView
                android:id="@+id/iv_web"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/origin_format"
                android:paddingRight="2dp"
                android:src="@drawable/ic_web_outline"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_origin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/origin_format" />

            <io.legado.app.ui.widget.text.AccentTonalBgTextView
                android:id="@+id/tv_change_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/change_origin"
                android:textSize="@dimen/text_caption_l"
                app:radius="@dimen/radius_full" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/ic_book_last"
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/read_dur_progress"
                android:paddingRight="2dp"
                android:src="@drawable/ic_book_last"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_lasted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/read_dur_progress" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <ImageView
                android:layout_width="18sp"
                android:layout_height="18sp"
                android:contentDescription="@string/read_dur_progress"
                android:paddingRight="2dp"
                android:src="@drawable/ic_groups"
                app:skin_tint="onSurfaceVariant"
                app:tint="@color/tv_text_summary"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

            <TextView
                android:id="@+id/tv_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingRight="6dp"
                android:singleLine="true"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/tv_text_summary"
                android:textSize="@dimen/text_caption_l"
                tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                tools:text="@string/group_s" />

            <io.legado.app.ui.widget.text.AccentTonalBgTextView
                android:id="@+id/tv_change_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/change_group"
                android:textSize="@dimen/text_caption_l"
                app:radius="@dimen/radius_full" />

        </LinearLayout>

    </LinearLayout>

    <!-- N: 原 ll_toc(Chapters:… / View Chapters)已移除——与下方内嵌目录头(item_book_info_toc_header)
         的"Chapters: N / 排序"信息重复。打开完整目录页(搜索/分卷)的入口改由目录头承担(点整行)。 -->

</LinearLayout>
