<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_m">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mock_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="@dimen/toolbar_elevation"
            tools:cardBackgroundColor="#EEEEEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/top_bar_day"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    tools:background="#1F88E5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <View
                        android:id="@+id/placeholder_day_1"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginBottom="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_l"
                        tools:background="#79747E" />

                    <View
                        android:id="@+id/placeholder_day_2"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginEnd="@dimen/space_xl"
                        tools:background="#79747E" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_s">

                    <View
                        android:id="@+id/accent_day"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        tools:background="#263238" />

                </FrameLayout>

                <View
                    android:id="@+id/bottom_bar_day"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    tools:background="#1F88E5" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/day"
            android:textSize="@dimen/text_caption"
            app:skin_textColor="onSurfaceVariant" />

    </LinearLayout>

    <Space
        android:layout_width="@dimen/space_m"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mock_night"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="@dimen/toolbar_elevation"
            tools:cardBackgroundColor="#222222">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:id="@+id/top_bar_night"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    tools:background="#1F3340" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <View
                        android:id="@+id/placeholder_night_1"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginBottom="@dimen/space_s"
                        android:layout_marginEnd="@dimen/space_l"
                        tools:background="#79747E" />

                    <View
                        android:id="@+id/placeholder_night_2"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginEnd="@dimen/space_xl"
                        tools:background="#79747E" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_s">

                    <View
                        android:id="@+id/accent_night"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        tools:background="#E06666" />

                </FrameLayout>

                <View
                    android:id="@+id/bottom_bar_night"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    tools:background="#22262C" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/night"
            android:textSize="@dimen/text_caption"
            app:skin_textColor="onSurfaceVariant" />

    </LinearLayout>

</LinearLayout>
