<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingTop="@dimen/space_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="@dimen/space_s"
            android:text="@string/bookshelf_layout"
            app:skin_textColor="onSurface"
            android:textColor="@color/primaryText"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/view"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/secondaryText"
            android:textSize="@dimen/text_caption_l" />

        <LinearLayout
            android:id="@+id/ll_view_cells"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cell_view_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    android:id="@+id/iv_view_list"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shelf_view_list" />

                <TextView
                    android:id="@+id/tv_view_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/shelf_view_list"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell_view_grid3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    android:id="@+id/iv_view_grid3"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shelf_view_grid3" />

                <TextView
                    android:id="@+id/tv_view_grid3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/shelf_view_col3"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell_view_grid4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    android:id="@+id/iv_view_grid4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shelf_view_grid4" />

                <TextView
                    android:id="@+id/tv_view_grid4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/shelf_view_col4"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell_view_grid5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    android:id="@+id/iv_view_grid5"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shelf_view_grid5" />

                <TextView
                    android:id="@+id/tv_view_grid5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/shelf_view_col5"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell_view_grid6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_s">

                <ImageView
                    android:id="@+id/iv_view_grid6"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shelf_view_grid6" />

                <TextView
                    android:id="@+id/tv_view_grid6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/shelf_view_col6"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/sort"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/secondaryText"
            android:textSize="@dimen/text_caption_l" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sort_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_0"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />

            <TextView
                android:id="@+id/tv_sort_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_1"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />

            <TextView
                android:id="@+id/tv_sort_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_2"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sort_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_3"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />

            <TextView
                android:id="@+id/tv_sort_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_4"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />

            <TextView
                android:id="@+id/tv_sort_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:paddingVertical="9dp"
                android:text="@string/bookshelf_px_5"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/group_style"
                app:skin_textColor="onSurfaceVariant"
                android:textColor="@color/secondaryText"
                android:textSize="@dimen/text_caption_l" />

            <TextView
                android:id="@+id/tv_group_style_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="72dp"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="9dp"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l"
                tools:text="Tab" />

            <TextView
                android:id="@+id/tv_group_style_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="72dp"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="9dp"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText"
                android:textSize="@dimen/text_caption_l"
                tools:text="Folder" />
        </LinearLayout>

        <View
            android:id="@+id/v_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_s" />

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_unread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/show_unread"
            tools:ignore="TouchTargetSizeCheck" />

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_last_update_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/show_last_update_time"
            tools:ignore="TouchTargetSizeCheck" />

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_read_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/show_read_progress"
            tools:ignore="TouchTargetSizeCheck" />

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_wait_up_books"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/show_wait_up_count"
            tools:ignore="TouchTargetSizeCheck" />

        <io.legado.app.lib.theme.view.ThemeSwitch
            android:id="@+id/sw_show_bookshelf_fast_scroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/show_bookshelf_fast_scroller"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
