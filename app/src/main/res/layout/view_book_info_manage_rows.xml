<?xml version="1.0" encoding="utf-8"?>
<!-- N5 C5a: 详情页管理三行块(书源/最新/分组)——从 land activity_book_info.xml 与 portrait
     item_book_info_header.xml 的逐字重复子树抽出。两处原来一份用 AccentBgTextView、一份用
     AccentTonalBgTextView,统一为 AccentTonalBgTextView(land fl_action 已有 Tonal 表次级操作的
     先例,tv_change_source/tv_change_group 语义上正是次级操作)。所有 id 原样保留。 -->
<!-- 无自带水平 padding:行内容左右缘=面板内容缩进 space_l。
     图标行统一规格(18dp 图标+6dp 间距,同阅读进度行/目录头),行文字一律落在 40dp 轨 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <ImageView
            android:id="@+id/iv_web"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/origin_format"
            android:src="@drawable/ic_web_outline"
            app:skin_tint="onSurfaceVariant"
            app:tint="@color/tv_text_summary" />

        <TextView
            android:id="@+id/tv_origin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingRight="6dp"
            android:singleLine="true"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/tv_text_summary"
            android:textSize="@dimen/text_caption_l"
            tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
            tools:text="@string/origin_format" />

        <io.legado.app.ui.widget.text.AccentTonalBgTextView
            android:id="@+id/tv_change_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/change_origin"
            android:textSize="@dimen/text_caption_l"
            app:radius="@dimen/radius_full" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/ic_book_last"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/read_dur_progress"
            android:src="@drawable/ic_book_last"
            app:skin_tint="onSurfaceVariant"
            app:tint="@color/tv_text_summary" />

        <TextView
            android:id="@+id/tv_lasted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingRight="6dp"
            android:singleLine="true"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/tv_text_summary"
            android:textSize="@dimen/text_caption_l"
            tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
            tools:text="@string/read_dur_progress" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/read_dur_progress"
            android:src="@drawable/ic_groups"
            app:skin_tint="onSurfaceVariant"
            app:tint="@color/tv_text_summary" />

        <TextView
            android:id="@+id/tv_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingRight="6dp"
            android:singleLine="true"
            app:skin_textColor="onSurfaceVariant"
            android:textColor="@color/tv_text_summary"
            android:textSize="@dimen/text_caption_l"
            tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
            tools:text="@string/group_s" />

        <io.legado.app.ui.widget.text.AccentTonalBgTextView
            android:id="@+id/tv_change_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/change_group"
            android:textSize="@dimen/text_caption_l"
            app:radius="@dimen/radius_full" />

    </LinearLayout>

</LinearLayout>
