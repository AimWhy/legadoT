<?xml version="1.0" encoding="utf-8"?>
<!-- 区块头样式与信息头的阅读进度行对齐(18dp 前置图标+subtitle 加粗),
     水平 padding=space_l 与面板内容缩进及 item_chapter_list 咬合,"目录"才与章节名左对齐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_s">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/chapter_list"
        android:src="@drawable/ic_folder_open"
        app:skin_tint="secondary"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/tv_toc_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textStyle="bold"
        app:skin_textColor="onSurface"
        android:textColor="@color/primaryText"
        android:textSize="@dimen/text_subtitle" />

    <!-- 打开完整目录页(搜索/分卷/定位)。整行也绑同一动作,此图标提供"这里可展开更多"的视觉暗示。
         接管原信息卡 ll_toc 的 View Chapters 入口。 -->
    <ImageView
        android:id="@+id/iv_toc_open"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/space_m"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/view_toc"
        android:src="@drawable/ic_search"
        app:skin_tint="primary"
        app:tint="@color/tv_text_summary" />

    <ImageView
        android:id="@+id/iv_toc_sort"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sort"
        android:src="@drawable/ic_arrow_down"
        app:skin_tint="primary"
        app:tint="@color/tv_text_summary" />

</LinearLayout>
