<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_s">

    <TextView
        android:id="@+id/tv_toc_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        app:skin_textColor="onSurface"
        android:textColor="@color/primaryText"
        android:textSize="@dimen/text_subtitle" />

    <ImageView
        android:id="@+id/iv_toc_sort"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/sort"
        android:src="@drawable/ic_arrow_down"
        app:skin_tint="primary"
        app:tint="@color/tv_text_summary" />

</LinearLayout>
