<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_m">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_role_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="@color/primaryText"
            app:skin_textColor="onSurface"
            tools:text="林黛玉" />

        <TextView
            android:id="@+id/tv_role_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/secondaryText"
            app:skin_textColor="onSurfaceVariant"
            tools:text="female · 第 3 章出场" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_role_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_s"
        android:clickable="true"
        android:focusable="true"
        android:textSize="@dimen/text_body"
        android:textColor="@color/primaryText"
        app:skin_textColor="onSurface"
        tools:text="Yunxi" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_merge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/space_s"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/role_merge"
        android:src="@drawable/ic_link_24dp"
        app:skin_tint="onSurface"
        app:tint="@color/primaryText" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_preview"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/role_cast"
        android:src="@drawable/ic_volume_up"
        app:skin_tint="onSurface"
        app:tint="@color/primaryText" />

</LinearLayout>
