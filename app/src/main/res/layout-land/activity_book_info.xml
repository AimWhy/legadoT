<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    app:skin_background="background"
    android:orientation="horizontal"
    tools:ignore="DisableBaselineAlignment">

    <LinearLayout
        android:id="@+id/ll_header_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:background="@color/background"
        app:skin_background="background"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize">

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.App.Title"
                app:skin_textColor="onSurface"
                android:textColor="@color/primaryText" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="@dimen/space_m">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_cover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/radius_m"
                    app:cardElevation="4dp">

                    <io.legado.app.ui.widget.image.CoverImageView
                        android:id="@+id/iv_cover"
                        android:layout_width="110dp"
                        android:layout_height="160dp"
                        android:contentDescription="@string/img_cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/image_cover_default"
                        app:coverCornerRadius="0dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/book_name"
                    android:textAppearance="@style/TextAppearance.App.Display"
                    android:textSize="28sp"
                    app:skin_textColor="onSurface"
                    android:textColor="@color/primaryText" />

                <TextView
                    android:id="@+id/tv_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/author"
                    android:textSize="@dimen/text_body"
                    app:skin_textColor="onSurfaceVariant"
                    android:textColor="@color/tv_text_summary" />

                <io.legado.app.ui.widget.LabelsBar
                    android:id="@+id/lb_kind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/fl_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_menu"
            app:skin_background="themeBottomBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <io.legado.app.ui.widget.text.AccentTonalBgTextView
                android:id="@+id/tv_shelf"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/remove_from_bookshelf"
                android:textSize="@dimen/text_body_l"
                app:radius="@dimen/radius_full" />

            <io.legado.app.ui.widget.text.AccentBgTextView
                android:id="@+id/tv_read"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_m"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/reading"
                android:textSize="@dimen/text_body_l"
                app:radius="@dimen/radius_full" />

        </LinearLayout>

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58">

        <io.legado.app.ui.widget.NoChildScrollNestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/ll_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/background"
                app:skin_background="background"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingTop="@dimen/space_l"
                android:paddingBottom="@dimen/space_s">

                <!-- N5 C5a: 管理三行块(书源/最新/分组)抽为共享 include,与 item_book_info_header.xml
                     同源(见 view_book_info_manage_rows.xml 头注)。需要自带 id 才能让 include 的子
                     view id 在 ActivityBookInfoBinding 里展开为可访问字段(空 id 的 include 不展开)。 -->
                <include
                    android:id="@+id/manage_rows"
                    layout="@layout/view_book_info_manage_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:id="@+id/v_intro_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/space_s"
                    android:background="@color/divider" />

                <io.legado.app.ui.widget.text.ScrollTextView
                    android:id="@+id/tv_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:maxLines="4"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/space_s"
                    android:text="@string/book_intro"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_body"
                    android:visibility="visible"
                    app:skin_textColor="onSurfaceVariant"
                    android:textColor="@color/secondaryText"
                    tools:ignore="RtlHardcoded,RtlSymmetry" />

                <io.legado.app.ui.widget.text.AccentTextView
                    android:id="@+id/tv_intro_expand"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_s"
                    android:text="@string/book_intro_expand"
                    android:textSize="@dimen/text_caption_l"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_toc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_s"
                    android:paddingBottom="@dimen/space_s">

                    <ImageView
                        android:layout_width="18sp"
                        android:layout_height="18sp"
                        android:contentDescription="@string/read_dur_progress"
                        android:paddingRight="2dp"
                        android:src="@drawable/ic_folder_open"
                        app:skin_tint="onSurfaceVariant"
                        app:tint="@color/tv_text_summary"
                        tools:ignore="RtlHardcoded,RtlSymmetry" />

                    <TextView
                        android:id="@+id/tv_toc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:paddingRight="6dp"
                        android:singleLine="true"
                        app:skin_textColor="onSurface"
                        android:textColor="@color/primaryText"
                        android:textSize="@dimen/text_subtitle"
                        tools:ignore="NestedWeights,RtlHardcoded,RtlSymmetry"
                        tools:text="@string/toc_s" />

                    <io.legado.app.ui.widget.text.AccentBgTextView
                        android:id="@+id/tv_toc_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/view_toc"
                        android:textSize="@dimen/text_caption_l"
                        app:radius="@dimen/radius_full" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_toc_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </io.legado.app.ui.widget.NoChildScrollNestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
